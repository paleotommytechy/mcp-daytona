# Daytona MCP - private production worker
# Copy to .env.local locally. Never commit real values.

# Daytona API
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# GitHub App authentication
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Required before exposing /mcp publicly. Use a random 32+ character secret.
# Temporary bearer protection only; ChatGPT plugin integration requires OAuth 2.1.
MCP_BEARER_TOKEN=
